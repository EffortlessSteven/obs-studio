# ============================================================================
# General Strategy: Ignore everything at the root level by default,
# then explicitly un-ignore necessary project files and directories.
# ============================================================================
/*

# --- Core Project Structure ---
# Un-ignore essential directories and files required for the project.
!/.github/
!/build-aux/
!/cmake/
!/deps/
!/docs/
!/frontend/
!/libobs/           # Explicit directory listing for clarity
!/libobs-winrt/     # Explicit directory listing for clarity
!/plugins/
!/shared/
!/test/
!/.cirrus.yml    # Changed from .xml to .yml based on common usage
!/.clang-format
!/.editorconfig
!/.gersemirc
!/.git-blame-ignore-devs
!/.gitmodules
!/.gitignore
!/.mailmap
!/.swift-format
!/AUTHORS
!/buildspec.json
!/CMakeLists.txt
!/CMakePresets.json
!/COC.rst
!/COMMITMENT
!/CONTRIBUTING.rst
!/COPYING
!/INSTALL
!/README.rst

# --- Specific Exclusions & Generated Files ---
# Exclude lock files
*.lock.json
*.lock
package-lock.json
yarn.lock

# Exclude files generated by Sphinx in-tree
/docs/sphinx/_build/*
!/docs/sphinx/_build/.gitignore

# Exclude modified Flatpak files
/build-aux/flatpak-github-action-modified-*

# Exclude OS-specific metadata files
.DS_Store       # macOS
Thumbs.db       # Windows
ehthumbs.db     # Windows

# Exclude editor/IDE files
.idea/
.vscode/
*.suo
*.user
*.sln.docstates

# Exclude CMake build number cache and common CMake artifacts
/cmake/.CMakeBuildNumber
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json

# Exclude Qodo
.qodo

# Build directories (explicitly ignored at root for extra safety/clarity)
# Note: These are already covered by '/*', but listing helps readability.
/build/
/build_*/ # Covers build_x64, build_x86 etc.
/out/

# Exclude build directories anywhere in the project tree
**/build/
**/out/
**/dist/
**/bin/
**/obj/
